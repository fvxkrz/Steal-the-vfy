{
  "name": "steal-the-vfy-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts && npm run test --workspace=steal-the-vfy-simple-demo",
    "test:service": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:demo": "npm run test --workspace=steal-the-vfy-simple-demo",
    "demo:test": "npm run test --workspace=steal-the-vfy-simple-demo",
    "demo:start": "npm start --workspace=steal-the-vfy-simple-demo",
    "replay": "tsx scripts/replay.ts",
    "commitment": "tsx scripts/commitment.ts",
    "artifacts:verify": "tsx scripts/artifacts.ts verify",
    "vk:register": "tsx scripts/register-vk.ts"
  },
  "workspaces": ["simple-demo"],
  "overrides": {
    "underscore": "1.13.8"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8",
    "poseidon-lite": "0.3.0",
    "snarkjs": "0.7.6",
    "viem": "2.57.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
